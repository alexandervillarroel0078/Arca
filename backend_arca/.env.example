# Configuracion SOLO por variables de entorno. En desarrollo puedes copiar este archivo a .env (nunca se versiona).
# En produccion NO existe .env: las variables se definen en el panel del servicio (ver ../DESPLIEGUE.md).

# 'desarrollo' (por defecto) o 'produccion'. Con 'produccion' la app NO arranca si falta algo o es inseguro.
ENTORNO=desarrollo

# Base de datos. Acepta sslmode=require (Neon lo exige): postgresql://USUARIO:CLAVE@HOST/base?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:CAMBIAR@localhost:5432/arca2
# Solo para las pruebas (siempre una base llamada arca_test). No se usa en produccion.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:CAMBIAR@localhost:5432/arca_test

# Secreto de las sesiones. En produccion: 32+ caracteres al azar:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRA_MINUTOS=1440

# Origenes permitidos (URL del frontend), separados por comas y sin barra final.
CORS_ORIGENES=http://localhost:5173

# Registro libre de cuentas: true/false. Por defecto: true en desarrollo, false en produccion
# (cerrado, pero si no hay ningun usuario permite crear el primer admin).
# REGISTRO_ABIERTO=false
