# URL del backend, SIN barra final. Se lee al COMPILAR (npm run dev / npm run build).
#   - Desarrollo: http://localhost:8000
#   - Produccion (Vercel > Settings > Environment Variables): https://TU-API.onrender.com
# En desarrollo, si se omite, se usa el puerto 8000 del mismo equipo. En produccion es OBLIGATORIA.
VITE_API_URL=http://localhost:8000

# Opcional: identificador de la compilacion (se muestra en la pantalla de entrada). Por defecto: el commit de Vercel o "local".
# VITE_BUILD_ID=
